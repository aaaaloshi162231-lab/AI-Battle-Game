<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Battle Arena</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#080b16;
    color:white;
}

/* HEADER */
header{
    height:70px;
    background:#11162a;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
    border-bottom:1px solid #252d4d;
}

.logo{
    font-size:22px;
    font-weight:bold;
    color:#6ea8ff;
}

.status{
    background:#163522;
    color:#48e58b;
    padding:9px 16px;
    border-radius:20px;
    font-size:13px;
}

/* LAYOUT */
.layout{
    display:flex;
    min-height:calc(100vh - 70px);
}

/* SIDEBAR */
.sidebar{
    width:230px;
    background:#0e1324;
    padding:25px 15px;
    border-right:1px solid #252d4d;
}

.sidebar h3{
    color:#7f